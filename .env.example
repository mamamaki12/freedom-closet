# ---- アプリ（ブラウザ側）----
# 使うAI: local（端末内）または claude（Claude API。中継サーバー経由）
VITE_AI_PROVIDER=local
# Claudeモードの中継サーバーのURL。空なら同じオリジンの /api を使う
VITE_AI_API_BASE=
# 端末内AIで使う画像分類モデル（Transformers.js対応のCLIP系モデル）
VITE_LOCAL_MODEL=Xenova/clip-vit-base-patch32

# ---- 中継サーバー（server/）----
# APIキーはサーバー側だけに置く。VITE_ を付けない（付けるとブラウザに埋め込まれる）
ANTHROPIC_API_KEY=
# 似た着こなしの写真を探す Pexels のAPIキー（任意。なければイラストと検索リンクだけ出す）
# https://www.pexels.com/api/ で無料で取れる
PEXELS_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 写真の判定（種類・色）だけ別のモデルにしたいとき。未設定なら CLAUDE_MODEL と同じ
CLAUDE_MODEL_ANALYZE=
PORT=8787
# 待ち受けるアドレス。初期値 127.0.0.1 はこのパソコンの中からだけ（同じWi-Fiのほかの人は使えない）。
# サーバー（Cloud Run・Render など）に置いて公開するときは 0.0.0.0
HOST=
# アプリを置くオリジン（カンマ区切りで複数可。例：https://<ユーザー名>.github.io）。これ以外のサイトのページからは断る。
# 空なら開発用に localhost のページだけ受ける（Viteのプロキシ経由ならこのままでよい）
ALLOWED_ORIGIN=
# 合言葉。決めると、アプリの設定（Claude API の下）に同じ合言葉を入れた端末だけが使える。
# 公開するなら必ず決める（推測されにくい長い文字列。例：openssl rand -hex 16 の結果）
RELAY_ACCESS_CODE=
# 回数制限（0 は制限なし）。1つのIPアドレスから10分あたり／Claude を呼ぶのは1日（日本時間）に合計
RATE_LIMIT_PER_10MIN=120
CLAUDE_DAILY_LIMIT=300
# 前にプロキシがいるとき、その数（Cloud Run・Render は 1）。回数制限で、本当の接続元のアドレスを使うため
TRUST_PROXY=0
